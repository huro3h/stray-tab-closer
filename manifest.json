{
  "manifest_version": 3,
  "name": "Stray Tab Closer",
  "version": "1.0.0",
  "description": "監視対象サイトから開かれた別ドメインのタブを自動で閉じる",
  "permissions": ["tabs", "storage"],
  "action": {
    "default_title": "Stray Tab Closer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
